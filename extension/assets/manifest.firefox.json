{
  "manifest_version": 3,
  "name": "Ship It",
  "version": "0.2.0",
  "description": "Connect your store session to the local Ship It grocery planner.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.mathem.se/*",
    "https://www.willys.se/*",
    "https://www.hemkop.se/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mathem.se/*",
        "https://www.willys.se/*",
        "https://www.hemkop.se/*"
      ],
      "js": [
        "adapters.js",
        "overlay.js",
        "content.js"
      ]
    },
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ship-it@kristalalfred",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
